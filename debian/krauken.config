#!/bin/sh
# Runs BEFORE files are unpacked (fresh install or upgrade) -- its only
# job is detecting whether brewpi.service exists and, if so, asking the
# krauken/replace-brewpi debconf question so postinst has an answer ready
# by the time it needs one. Must stay side-effect-free (no stopping
# services, no file writes) -- that's postinst's job, once the answer is
# actually confirmed; a `config` script needs to be safe to re-run on its
# own (e.g. via dpkg-reconfigure) without redoing real work.
set -e

. /usr/share/debconf/confmodule

if systemctl list-unit-files 2>/dev/null | grep -q '^brewpi\.service'; then
    db_input high krauken/replace-brewpi || true
    db_go || true
fi

# krauken/has-krauken-hardware: unlike brewpi.service above, there's no
# runtime signal to detect "do you have a Krauken PCB" -- that's exactly
# what the EEPROM this question gates provisions in the first place
# (chicken-and-egg). So this is gated behind an explicit release flag
# instead of a detection check. Flip to true (or drop this guard
# entirely) once real Krauken hardware exists and installers should
# actually start being asked -- until then the template's own Default:
# false is what silently applies to every install, and
# krauken.postinst's eeptools build stays skipped accordingly.
KRAUKEN_HARDWARE_RELEASED=false
if [ "$KRAUKEN_HARDWARE_RELEASED" = true ]; then
    db_input medium krauken/has-krauken-hardware || true
    db_go || true
fi

exit 0
